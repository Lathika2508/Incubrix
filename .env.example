# IncuBrix Visibility Engine Environment Configuration
# Copy this file to .env for local overrides (never commit actual secrets)

# Application Settings
ENVIRONMENT=production
DEBUG=false
PORT=8000
STREAMLIT_PORT=8501

# Database Configuration
DATABASE_URL=sqlite:///D:/incubrix project final/visibility_engine.db

# Crawler & Audit Settings
CRAWLER_USER_AGENT=IncuBrixAuditBot/1.0
REQUEST_TIMEOUT_SECONDS=10

# Third-Party API Keys (Optional - Engine runs fully on public endpoints)
PERPLEXITY_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
